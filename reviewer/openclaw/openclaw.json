{
  "tools": {
    "allow": [
      "fs_readonly__list_files",
      "fs_readonly__read_file",
      "fs_readonly__grep"
    ],
    "deny": [
      "exec",
      "process",
      "shell",
      "bash",
      "write",
      "edit",
      "apply_patch",
      "multi_edit",
      "web_fetch",
      "web_search",
      "browser",
      "message_send",
      "sessions_spawn",
      "subagents",
      "agent_to_agent",
      "cron",
      "automations",
      "memory",
      "memory_search",
      "file_transfer",
      "canvas",
      "tts"
    ],
    "elevated": {
      "enabled": false
    },
    "web": {
      "fetch": {
        "enabled": false
      },
      "search": {
        "enabled": false
      }
    },
    "fs": {
      "workspaceOnly": true
    },
    "exec": {
      "mode": "deny",
      "applyPatch": {
        "enabled": false
      }
    }
  },
  "browser": {
    "enabled": false
  },
  "telemetry": {
    "enabled": false
  },
  "agents": {
    "defaults": {
      "sandbox": {
        "workspaceAccess": "none"
      },
      "timeoutSeconds": 540,
      "skills": [
        "analyze-dependabot-pr"
      ]
    }
  },
  "mcp": {
    "servers": {
      "fs_readonly": {
        "type": "stdio",
        "command": "python3",
        "args": [
          "-m",
          "fs_readonly",
          "--root",
          "/work"
        ]
      }
    }
  },
  "models": {
    "providers": {
      "amazon-bedrock": {
        "auth": "aws-sdk",
        "region": "us-west-2",
        "models": [
          {
            "id": "us.anthropic.claude-sonnet-4-5-20250929-v1:0",
            "name": "Claude Sonnet 4.5 (Bedrock, us-west-2 inference profile)",
            "contextTokens": 200000,
            "maxTokens": 8192
          }
        ],
        "api": "bedrock-converse-stream"
      }
    }
  },
  "plugins": {
    "allow": [
      "amazon-bedrock"
    ],
    "entries": {
      "amazon-bedrock": {
        "enabled": true,
        "config": {
          "discovery": {
            "enabled": false,
            "region": "us-west-2"
          },
          "guardrail": {
            "guardrailIdentifier": "lubjaymwc18i",
            "guardrailVersion": "1",
            "streamProcessingMode": "sync",
            "trace": "enabled"
          }
        }
      }
    },
    "load": {
      "paths": [
        "/usr/local/lib/node_modules/@openclaw/amazon-bedrock-provider"
      ]
    }
  },
  "skills": {
    "load": {
      "extraDirs": [
        "/opt/kinglet/skills"
      ],
      "watch": false
    },
    "limits": {
      "maxSkillsInPrompt": 4
    }
  }
}
